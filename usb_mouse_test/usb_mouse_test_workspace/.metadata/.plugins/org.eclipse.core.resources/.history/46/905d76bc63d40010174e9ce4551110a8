#include "xil_printf.h"
#include "sleep.h"
#include "max3421e.h"
#include "xparameters.h"

int main()
{
    xil_printf("\r\n=== Simple SPI Test ===\r\n");

    // Initialize
    max3421e_spi_init(XPAR_AXI_QUAD_SPI_0_DEVICE_ID, XPAR_AXI_GPIO_0_DEVICE_ID);

    // Just try to init the chip
    max3421e_chip_init();

    // Read revision 10 times
    xil_printf("\r\nReading revision register:\r\n");
    for (int i = 0; i < 10; i++) {
        u8 rev = max3421e_read_reg(rREVISION);
        xil_printf("  Attempt %d: 0x%02X\r\n", i+1, rev);
        sleep(1);
    }

    while(1);
    return 0;
}
