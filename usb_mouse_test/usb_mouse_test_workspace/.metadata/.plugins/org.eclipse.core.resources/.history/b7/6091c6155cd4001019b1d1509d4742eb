#include "xil_printf.h"
#include "xgpio.h"
#include "sleep.h"
#include "xparameters.h"

int main()
{
    // Try to write directly to LED address (LED[0] accent on Urbana)
    // This is a raw memory write to GPIO - just to see if CPU is running

    volatile unsigned int *gpio_led = (unsigned int *)0x40000000; // GPIO base address

    int count = 0;

    while(1) {
        // Toggle GPIO output (this controls USB_RST in our design, but will show activity)
        *gpio_led = count & 1;

        // Also try UART
        xil_printf("Count: %d\r\n", count);

        count++;
        sleep(1);
    }

    return 0;
}
